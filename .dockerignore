# Rust target dir (rebuilt inside the image)
target/

# Local state — neither belongs in the image
config.toml
cache/

# Git + editor + macOS noise
.git/
.gitignore
.gitattributes
.DS_Store
**/.DS_Store

# Compose / Docker artifacts (don't bake yourself into your own context)
docker-compose.yml
Dockerfile
.dockerignore

# Repo docs, plans (binary doesn't need them)
*.md
